{
  "veto": "payroll|statutory|contribution|\\btax\\b|migration|production|deploy|security|\\bauth\\b|credential|secret|failing|not working|why is|debug|refactor|architect",
  "hardness": "\\b(architect|design the|rewrite|from scratch|end.to.end|whole (system|module)|root cause|intermittent|race condition|data loss|corrupt|audit)\\b",
  "escalate": "\\band\\b.*\\b(also|then)\\b|\\bthen\\b",
  "tiers": [
    {
      "tier": "T0",
      "match": "^(which model|what (exactly |really )?(is|does|are|do)|define|explain|meaning of)\\b",
      "inline": true
    },
    {
      "tier": "T1",
      "match": "^(where|which file|what calls|find|locate|list all|map|show me all)\\b",
      "agent": "orch-scout",
      "model": "haiku"
    },
    {
      "tier": "T3",
      "match": "\\b(commit message|changelog|summari[sz]e|write docs|readme|commit (all|this|these|my) )\\b",
      "agent": "orch-scribe",
      "model": "haiku"
    },
    {
      "tier": "T2",
      "match": "\\b(typo|rename|remove the comment|reformat|add a field|change the (label|text|string))\\b",
      "agent": "orch-hand",
      "model": "haiku"
    },
    {
      "tier": "T4",
      "match": "^(add|create|implement|build)\\b",
      "agent": "orch-mid",
      "model": "sonnet"
    }
  ],
  "t6": {
    "agent": "orch-deep",
    "model": "fable"
  }
}
